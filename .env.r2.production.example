# ==============================================================================
# RevertLens Production Environment Configuration — R2 (Secondary Deployment)
# URL: [USER INPUT REQUIRED: Set to your actual R2 domain e.g. https://revertlens-r2.onrender.com]
# Note: Keep completely distinct credentials, database, and sessions from R1.
# ==============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=
DATABASE_PATH=/app/data/revertlens.sqlite

# Canonical public base URL and CORS for R2 (Do not use R1 URL)
PUBLIC_BASE_URL=
CORS_ORIGIN=

# Authentication & Security (Generate dedicated distinct secrets for R2)
SESSION_SECRET=
OPERATOR_PASSWORD_HASH=
RATE_LIMIT_INVESTIGATIONS_MAX=10
RATE_LIMIT_INVESTIGATIONS_WINDOW_MS=60000
TRUST_PROXY=true

# Dedicated or shared Chainstack Celo Mainnet RPC Endpoint
CHAINSTACK_CELO_MAINNET_RPC_URL=

# Official Hackathon Attribution & Identity
CELO_ATTRIBUTION_TAG=celo_235f6ef56f5b
AGENT_WALLET_ADDRESS=0x3e1bef07824cd0E076F4907641F0A0EF27898e52

# Build with Buy Marketplace Integration (Zero-Spend Mode)
BUY_CLI_EXECUTABLE=
BUY_CLI_ARGS_PREFIX=
BUY_ENABLED=false
BUY_DAILY_BUDGET_ATOMIC=0
BUY_PER_INVESTIGATION_BUDGET_ATOMIC=0
BUY_PER_CALL_CAP_ATOMIC=0
BUY_ALLOWED_TOKEN_CONTRACTS=
BUY_ALLOWED_RECIPIENTS=
BUY_ALLOWED_CAPABILITY_IDS=

# Cencori LLM Inference (Zero-Spend Mode)
CENCORI_ENABLED=false

# Forensic Report Retention Policy
REPORT_TTL_DAYS=14
REPORTS_PUBLIC_BY_DEFAULT=false
