# Copy to .env locally. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/revertlens.sqlite
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_SECRET
OPERATOR_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
CORS_ORIGIN=http://localhost:5173

# Buy CLI configuration. Do not put private keys or seed phrases here.
BUY_CLI_PATH=buy
BUY_ENABLED=false
BUY_DAILY_BUDGET_ATOMIC=0
BUY_PER_INVESTIGATION_BUDGET_ATOMIC=0
BUY_PER_CALL_CAP_ATOMIC=0
BUY_ALLOWED_TOKEN_CONTRACTS=
BUY_ALLOWED_RECIPIENTS=
BUY_ALLOWED_CAPABILITY_IDS=

# Cencori is optional until live Gate 0 verification.
CENCORI_ENABLED=false

# Public report behaviour
REPORT_TTL_DAYS=14
REPORTS_PUBLIC_BY_DEFAULT=false
