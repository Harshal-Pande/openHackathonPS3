# Copy to .env locally. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/revertlens.sqlite
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_SECRET
OPERATOR_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
CORS_ORIGIN=http://localhost:5173

# Public Ingestion Rate Limiting (Default: 10 requests per minute per IP)
RATE_LIMIT_INVESTIGATIONS_MAX=10
RATE_LIMIT_INVESTIGATIONS_WINDOW_MS=60000

# Set to true only behind an authenticated reverse proxy (e.g. Nginx, Cloudflare)
TRUST_PROXY=false

# Sponsored Chainstack Celo Mainnet Node (Growth plan - Elastic Global Node)
# Obtain from Chainstack dashboard -> Access & credentials -> HTTPS endpoint
# Must support archive debug_traceTransaction with callTracer (OP Geth, Celo Mainnet 42220).
# For offline test suites and mock testing, this can remain blank.
# Excluded from Git. NEVER commit real credentials.
CHAINSTACK_CELO_MAINNET_RPC_URL=

# Official Celo Hackathon Attribution & Identity (Immutable defaults)
# Official assigned builder tag for Track PS3 (ERC-8021 Schema 0)
CELO_ATTRIBUTION_TAG=celo_235f6ef56f5b

# Official registered agent wallet address on Celo Mainnet (ERC-8004 Identity Owner)
AGENT_WALLET_ADDRESS=0x3e1bef07824cd0E076F4907641F0A0EF27898e52

# Buy CLI integration.
# Official integration: @celo/buy npm package (https://github.com/celo-org/buy-skill)
# Version confirmed: 0.8.5 (via npx @celo/buy@latest --version on 2026-11-07)
# Wallet is managed by `buy setup` and stored in the OS keychain — do NOT put private
# keys or seed phrases here or anywhere in this repository.
#
# Backend invokes: BUY_CLI_EXECUTABLE BUY_CLI_ARGS_PREFIX --json curl --max-amount <cap> ...
# To use a globally-installed buy, set: BUY_CLI_EXECUTABLE=buy, BUY_CLI_ARGS_PREFIX=
# To use npx (default, no install needed): BUY_CLI_EXECUTABLE=npx, BUY_CLI_ARGS_PREFIX=@celo/buy@latest
BUY_CLI_EXECUTABLE=npx
BUY_CLI_ARGS_PREFIX=@celo/buy@latest
BUY_ENABLED=false
BUY_DAILY_BUDGET_ATOMIC=0
BUY_PER_INVESTIGATION_BUDGET_ATOMIC=0
BUY_PER_CALL_CAP_ATOMIC=0
BUY_ALLOWED_TOKEN_CONTRACTS=
BUY_ALLOWED_RECIPIENTS=
BUY_ALLOWED_CAPABILITY_IDS=

# Cencori is optional until live Gate 0 verification.
CENCORI_ENABLED=false

# Public report behaviour
REPORT_TTL_DAYS=14
REPORTS_PUBLIC_BY_DEFAULT=false
