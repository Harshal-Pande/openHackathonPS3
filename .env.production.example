# ==============================================================================
# RevertLens Production Environment Configuration Template
# Target: Public Cloud Deployment (Render / Railway / Docker Web Service)
# Instructions:
#   1. Copy these variables into your Cloud Provider Dashboard (Environment Settings)
#      or into a production environment file.
#   2. Complete all required blank values marked below before launching.
#   3. NEVER commit real production secrets, passwords, or private RPC endpoints to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0

# PORT: Leave blank when deploying to Render / Railway (supplied dynamically by provider).
# In standalone Docker, defaults to 3000.
PORT=

# DATABASE_PATH: Persistent SQLite path. Mounted volume mountpoint in container.
DATABASE_PATH=/app/data/revertlens.sqlite

# PUBLIC_BASE_URL: [USER INPUT REQUIRED]
# Canonical public HTTPS URL of the deployed application (e.g. https://revertlens.onrender.com).
# In production, this MUST be an absolute HTTPS URL and CANNOT be localhost or a private IP.
PUBLIC_BASE_URL=

# CORS_ORIGIN: [USER INPUT REQUIRED]
# Explicit allowed frontend origin (e.g. https://revertlens.onrender.com).
# In production, wildcards (*) or empty values are strictly rejected.
CORS_ORIGIN=

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# SESSION_SECRET: [USER INPUT REQUIRED]
# High-entropy random secret (minimum 32 characters) for HMAC-SHA256 session signing.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# OPERATOR_PASSWORD_HASH: [USER INPUT REQUIRED]
# Valid scrypt password hash for /operator authentication.
# Generate via: node scripts/generate_operator_hash.mjs "your-chosen-password"
# Note: Known test fixture hashes are strictly rejected in production.
OPERATOR_PASSWORD_HASH=

# Public Forensic Ingestion Rate Limiting
RATE_LIMIT_INVESTIGATIONS_MAX=10
RATE_LIMIT_INVESTIGATIONS_WINDOW_MS=60000

# TRUST_PROXY: Set to true behind cloud reverse proxies (Render, Cloudflare, Railway).
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 3. Chainstack Celo Mainnet RPC Endpoint
# ------------------------------------------------------------------------------
# CHAINSTACK_CELO_MAINNET_RPC_URL: [USER INPUT REQUIRED]
# Dedicated Chainstack Celo Mainnet Elastic Global Node (OP Geth archive RPC).
# Required for live forensic investigation execution (callTracer, receipts, tx lookup).
# Leave blank for offline / mock testing mode.
CHAINSTACK_CELO_MAINNET_RPC_URL=

# ------------------------------------------------------------------------------
# 4. Official Hackathon Attribution & Identity (Immutable Defaults)
# ------------------------------------------------------------------------------
# Assigned builder attribution tag for Track PS3 (ERC-8021 Schema 0)
CELO_ATTRIBUTION_TAG=celo_235f6ef56f5b

# Official registered agent wallet address on Celo Mainnet (ERC-8004 Identity Owner)
AGENT_WALLET_ADDRESS=0x3e1bef07824cd0E076F4907641F0A0EF27898e52

# ------------------------------------------------------------------------------
# 5. Build with Buy Marketplace Integration (Disabled for $0.00 Zero-Spend Mode)
# ------------------------------------------------------------------------------
# Pinned local package entrypoint (node_modules/@celo/buy/dist/main.js).
# Runtime npx downloads and unpinned @latest fallbacks are strictly prohibited.
BUY_CLI_EXECUTABLE=
BUY_CLI_ARGS_PREFIX=
BUY_ENABLED=false
BUY_DAILY_BUDGET_ATOMIC=0
BUY_PER_INVESTIGATION_BUDGET_ATOMIC=0
BUY_PER_CALL_CAP_ATOMIC=0
BUY_ALLOWED_TOKEN_CONTRACTS=
BUY_ALLOWED_RECIPIENTS=
BUY_ALLOWED_CAPABILITY_IDS=

# ------------------------------------------------------------------------------
# 6. Cencori LLM Inference (Disabled for $0.00 Zero-Spend Mode)
# ------------------------------------------------------------------------------
CENCORI_ENABLED=false

# ------------------------------------------------------------------------------
# 7. Forensic Report Retention Policy
# ------------------------------------------------------------------------------
REPORT_TTL_DAYS=14
REPORTS_PUBLIC_BY_DEFAULT=false
